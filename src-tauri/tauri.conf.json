{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Knights Launcher",
	"version": "0.1.0",
	"identifier": "knights-launcher",
	"build": {
		"frontendDist": "../dist/browser",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run start",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Knight's Launcher",
				"width": 1024,
				"height": 700,
				"minWidth": 800,
				"minHeight": 560,
				"resizable": true,
				"backgroundColor": "#212529"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["appimage", "nsis"],
		"createUpdaterArtifacts": true,
		"windows": {
			"nsis": null
		},
		"icon": [
			"icons/app-icon.png",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RkE1MEE2NUE4QTRCRjEKUldUeFM0cGFwbEQ2Mk9mazlwZ1NucjFJeTRwM3FxOW1YblJxOXJRNHhjczFGdCtKSG9mTEJGdE4K",
			"endpoints": [
				"https://www.knights-tavern.com/installers/launcher/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
