{
    "identifier": "default",
    "description": "Default permissions for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "shell:allow-open",
        {
            "identifier": "shell:allow-spawn",
            "allow": [
                {
                    "name": "sh",
                    "cmd": "sh",
                    "args": ["-c", {"validator": ".*"}],
                    "sidecar": false
                },
                {
                    "name": "cmd",
                    "cmd": "cmd.exe",
                    "args": ["/c", {"validator": ".*"}],
                    "sidecar": false
                }
            ]
        },
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "sh",
                    "cmd": "sh",
                    "args": ["-c", {"validator": ".*"}],
                    "sidecar": false
                },
                {
                    "name": "cmd",
                    "cmd": "cmd.exe",
                    "args": ["/c", {"validator": ".*"}],
                    "sidecar": false
                }
            ]
        },
        {
            "identifier": "http:default",
            "allow": [
                {"url": "http://knights-tavern.local/*"},
                {"url": "https://knights-tavern.local/*"},
                {"url": "https://knights-tavern.com/*"}
            ]
        },
        "fs:default",
        "fs:allow-appdata-write-recursive",
        "fs:allow-appconfig-write-recursive",
        {
            "identifier": "fs:allow-exists",
            "allow": [
                {"path": "**"}
            ]
        },
        "dialog:default"
    ]
}
